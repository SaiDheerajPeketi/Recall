# Public hostname pointed at the server before Caddy starts.
RECALL_DOMAIN=recall.example.com
CADDY_ACME_EMAIL=operator@example.com

# Use a long, unique password. URL-encode reserved characters in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-secret
DATABASE_URL=postgresql+asyncpg://recall:replace-with-a-secret@postgres:5432/recall

# Supply one provider key at runtime; never commit the completed file.
GENERATION_PROVIDER=gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional containerized Ollama profile.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
